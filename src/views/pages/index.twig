{# Master Layout #}
{% extends "layouts.master" %}

{% block content %}
<div class="space-y-8 pb-12">

  {# 1. Hero Banner Slider / Promotion #}
  <section class="relative bg-theme-primary text-white py-12 px-4 sm:px-6 lg:px-8 rounded-3xl overflow-hidden shadow-xl mx-4 sm:mx-8 mt-4 border border-theme-silver/20">
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-4 text-center lg:text-right">
        <span class="inline-block bg-white/10 text-theme-silver text-xs font-bold px-3 py-1 rounded-full border border-white/10">
          <i class="salla-icon-shield"></i> {{ store.name }} | قطع أصلية ومضمونة
        </span>
        <h1 class="text-3xl sm:text-5xl font-black leading-tight text-white">
          {{ store.description|default('أفضل قطع الغيار والزيوت الأصلية لسيارتك بأعلى معايير الجودة') }}
        </h1>
        <p class="text-theme-silver text-sm sm:text-base max-w-xl">
          تصفح تشكيلتنا الواسعة من قطع هيونداي وكيا، فلاتر موبيس، وزيوت هيونداي إكستير الكورية المعتمدة.
        </p>
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
          <a href="#products-grid" class="btn-primary px-8 py-3 rounded-xl font-bold text-sm shadow-lg">
            تصفح كافة المنتجات
          </a>
        </div>
      </div>
    </div>
  </section>

  {# 2. Trust Badges / Features Bar #}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-theme-gray flex items-center justify-center text-theme-primary text-lg">
          <i class="salla-icon-certificate"></i>
        </div>
        <div>
          <h4 class="font-bold text-xs sm:text-sm text-gray-900">قطع أصلية 100%</h4>
          <p class="text-[11px] text-gray-500">ضمان الوكالة ومطابقة الهيكل</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-theme-gray flex items-center justify-center text-theme-primary text-lg">
          <i class="salla-icon-truck"></i>
        </div>
        <div>
          <h4 class="font-bold text-xs sm:text-sm text-gray-900">شحن سريع</h4>
          <p class="text-[11px] text-gray-500">لكافة مناطق ومدن المملكة</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-theme-gray flex items-center justify-center text-theme-primary text-lg">
          <i class="salla-icon-wallet"></i>
        </div>
        <div>
          <h4 class="font-bold text-xs sm:text-sm text-gray-900">تقسيط تابي & تمارا</h4>
          <p class="text-[11px] text-gray-500">4 دفعات بدون فوائد</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-theme-gray flex items-center justify-center text-theme-primary text-lg">
          <i class="salla-icon-shield"></i>
        </div>
        <div>
          <h4 class="font-bold text-xs sm:text-sm text-gray-900">دفع آمن</h4>
          <p class="text-[11px] text-gray-500">مدى، أبل باي، وفيزا</p>
        </div>
      </div>
    </div>
  </section>

  {# 3. Dynamic Products Grid (سلة Products Component) #}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4" id="products-grid">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-theme-primary">المنتجات الأكثر طلباً</h2>
        <p class="text-xs text-gray-500 mt-1">اختر القطع المتوافقة مع سيارتك مع ضمان الجودة</p>
      </div>
    </div>

    {# Salla Native Twilight Product Loop #}
    <salla-products-list source="latest" limit="8"></salla-products-list>
  </section>

</div>
{% endblock %}
